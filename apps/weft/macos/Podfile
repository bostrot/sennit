platform :osx, '14.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'ephemeral', 'Flutter-Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure \"flutter pub get\" is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Flutter-Generated.xcconfig, then run \"flutter pub get\""
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_macos_podfile_setup

# ONNX Runtime ships prebuilt *static* binaries, which CocoaPods' target
# validator refuses as transitive dependencies of dynamic frameworks — while
# flutter_vodozemac's Rust dylib is only embedded when frameworks are
# dynamic: building the whole graph static shipped an app without it, dead at
# first dlopen. Each pod builds as its own framework here, so the static ONNX
# archives link into flutter_onnxruntime.framework and work; the check is
# simply stricter than the layout it is checking. Disabling exactly that one
# validation is the established answer for this plugin pairing.
pre_install do |installer|
  Pod::Installer::Xcode::TargetValidator.send(
    :define_method,
    :verify_no_static_framework_transitive_dependencies,
  ) {}
end

target 'Runner' do
  use_frameworks!

  flutter_install_all_macos_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end

  # Patrol's XCUITest bundle. `:complete` rather than `:search_paths` — unlike
  # the unit tests above, this target *links* the patrol pod:
  # `RunnerUITests.m` is `@import patrol;` and a macro expansion, so headers
  # alone are not enough.
  #
  # No `use_modular_headers!`: patrol's own macOS example adds it, but
  # `use_frameworks!` above already builds every pod as a module, and turning
  # it on would change how the whole existing pod graph is built. The same
  # decision, for the same reason, as in `../ios/Podfile`.
  target 'RunnerUITests' do
    inherit! :complete
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_macos_build_settings(target)
    # Apple Silicon only — see AppInfo.xcconfig: the ONNX pods' x86_64 slice
    # is missing the CoreML EP symbol and breaks the universal link.
    target.build_configurations.each do |config|
      config.build_settings['EXCLUDED_ARCHS'] = 'x86_64'
    end
  end

  # onnxruntime-c is a static archive dressed as a framework, and under
  # dynamic use_frameworks! CocoaPods never hands it to the plugin's own
  # link — which is the very situation the disabled validator was refusing.
  # Appended into the plugin's own xcconfig values (a target-level override
  # would shadow them instead): the plugin's framework absorbs the archive,
  # and every ORT symbol resolves at build time.
  ort = '"${PODS_ROOT}/onnxruntime-c/onnxruntime.xcframework/macos-arm64_x86_64"'
  Dir.glob(File.join(installer.sandbox.root,
                     'Target Support Files/flutter_onnxruntime/*.xcconfig')) do |f|
    text = File.read(f)
    text = text.sub(/^FRAMEWORK_SEARCH_PATHS = (.*)$/) do
      "FRAMEWORK_SEARCH_PATHS = #{Regexp.last_match(1)} #{ort}"
    end
    text = text.sub(/^OTHER_LDFLAGS = (.*)$/) do
      "OTHER_LDFLAGS = #{Regexp.last_match(1)} -framework \"onnxruntime\""
    end
    File.write(f, text)
  end
end
