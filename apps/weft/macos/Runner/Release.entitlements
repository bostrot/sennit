<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Weft is a messenger: it must reach the user's homeserver, their own
	     transcription/embedding endpoints, and media downloads. Without this the
	     sandbox rejects every outbound connection with "Operation not permitted". -->
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
