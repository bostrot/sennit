<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Weft is a messenger: it must reach the user's homeserver, their own
	     transcription/embedding endpoints, and media downloads. Without this the
	     sandbox rejects every outbound connection with "Operation not permitted". -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- The attachment picker goes through NSOpenPanel and the media viewer's
	     Save action through NSSavePanel; under the sandbox the powerbox only
	     extends access to the chosen file when this is present. Without it the
	     panel opens, the user picks a photo, and the upload fails to read the
	     file they just selected — or Save writes nothing to the folder they just
	     chose. Read-*write* rather than read-only precisely because of Save. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Calling. Under the sandbox the absence of these is a *silent* capture
	     failure — the same class of bug as a missing `network.client`, and
	     harder to see: `getUserMedia` returns a stream whose tracks carry no
	     samples, so the call connects, the timer runs, and neither side hears
	     anything. Both keys on both configurations, because a release build that
	     works in debug and is silent in the wild is the worst version of it.
	     macOS gets no system call integration — the in-app sheet and a
	     notification are the whole surface — but it still needs the devices. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
</dict>
</plist>
