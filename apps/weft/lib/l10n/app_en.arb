  "settingsSectionHeaderSemantics": "{title}. {subtitle}",
  "@settingsSectionHeaderSemantics": {
    "description": "Screen-reader-only label for a settings section heading, which shows a bold title and a grey explanatory line under it. Not visible on screen: the two lines are read as one heading so that heading-by-heading navigation announces both. Use the sentence separator and spacing the language actually uses — a full stop and a space in English, a full-width period and no space in Chinese.",
    "placeholders": {
      "title": {
        "type": "String",
        "description": "The section's own heading, already translated.",
        "example": "Search & transcription"
      },
      "subtitle": {
        "type": "String",
        "description": "The sentence under the heading, already translated. Ends without punctuation.",
        "example": "Semantic search and voice transcription endpoints"
      }
    }
  },
  "settingsPrivacyWarningSemantics": "Privacy warning. {message}",
  "@settingsPrivacyWarningSemantics": {
    "description": "Screen-reader-only label for the red warning box at the top of a settings screen that can send data off the device. Not visible on screen: it exists because the red box and the shield icon carry the warning visually and a reader hears neither. Keep the leading words short and unambiguous.",
    "placeholders": {
      "message": {
        "type": "String",
        "description": "The warning sentence already shown in the box, passed through verbatim.",
        "example": "Search terms are sent to the endpoint you configure."
      }
    }
  },
