  "settingsReadReceiptsTitle": "Send read receipts",
  "@settingsReadReceiptsTitle": {
    "description": "Title of a switch row. A read receipt is the signal that tells a sender their message was read. Keep under ~30 chars."
  },
  "settingsReadReceiptsSubtitle": "Off, senders are not told you read their messages — on WhatsApp and friends too, via the bridge. Your own devices still sync.",
  "@settingsReadReceiptsSubtitle": {
    "description": "Two-to-three-line subtitle under the 'Send read receipts' switch. 'Off, ...' means 'when this is off'. 'WhatsApp and friends' means WhatsApp and similar messengers. The last sentence reassures that the reader's own phones and laptops still agree on what is unread. 'WhatsApp' is a product name and stays."
  },
  "settingsContactNamesTitle": "Use address book names",
  "@settingsContactNamesTitle": {
    "description": "Title of a switch row. 'Address book' = the phone's contacts app. Keep under ~30 chars."
  },
  "settingsContactNamesSubtitle": "Name people the way your contacts app does when a phone number matches, instead of the name WhatsApp or Signal reports. Matched on this device only.",
  "@settingsContactNamesSubtitle": {
    "description": "Three-line subtitle under the 'Use address book names' switch. 'WhatsApp' and 'Signal' are product names and stay. The last sentence is the privacy reassurance: no phone numbers leave the device."
  },
  "settingsContactsDenied": "Sennit was not allowed to read your contacts.",
  "@settingsContactsDenied": {
    "description": "Snackbar shown when the reader turns on 'Use address book names' and then denies the operating system's contacts permission. One short sentence. 'Sennit' is the app name and stays."
  },
  "settingsSendOnEnterTitle": "Return sends the message",
