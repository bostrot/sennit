    "maxLength": 28
  },
  "settingsSectionChats": "Chats",
  "@settingsSectionChats": {
    "description": "Section heading on the settings screen, above the rows about conversations and messenger networks. A short noun, not a sentence; keep under ~20 chars.",
    "maxLength": 40
  },
  "settingsSectionLookAndFeel": "Look & feel",
  "@settingsSectionLookAndFeel": {
    "description": "Section heading on the settings screen, above theme, notifications and keyboard rows. Idiomatic phrase for 'how the app looks and behaves'; keep under ~20 chars.",
    "maxLength": 40
  },
  "settingsSectionSearchAndIntelligence": "Search & intelligence",
  "@settingsSectionSearchAndIntelligence": {
    "description": "Section heading on the settings screen, above search, transcription, local AI models and appointment detection. 'Intelligence' here means on-device machine learning; keep under ~26 chars."
  },
  "settingsSectionPrivacyAndSecurity": "Privacy & security",
  "@settingsSectionPrivacyAndSecurity": {
    "description": "Section heading on the settings screen, above read receipts, contact names, link previews, devices and encryption. Keep under ~26 chars."
  },
  "settingsSectionConnections": "Connections",
