    "description": "Subtitle under the 'Return sends the message' switch when it is ON. Key names (Shift, Return) should match the language's keyboard labels. One short sentence."
  },
  "settingsSendOnEnterSubtitleOff": "Return starts a new line. Cmd or Ctrl + Return sends.",
  "@settingsSendOnEnterSubtitleOff": {
    "description": "Subtitle under the 'Return sends the message' switch when it is OFF. Cmd is the macOS modifier key, Ctrl the Windows and Linux one; keep both. Two short sentences."
  },
  "settingsAgendaTitle": "Detect appointments",
