  "@settingsAgendaSubtitle": {
    "description": "Two-line subtitle under the 'Detect appointments' switch. The quoted phrase is the label of the button that appears under such a message — translate it to match that button. The second sentence is the privacy reassurance. Use the language's own quotation marks."
  },
  "settingsHiddenNetworksTitle": "Hide networks from All",
