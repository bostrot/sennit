# Uncomment this line to define a global platform for your project
platform :ios, '16.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

# ONNX Runtime ships prebuilt *static* binaries, which CocoaPods' target
# validator refuses as transitive dependencies of dynamic frameworks — while
# flutter_vodozemac's Rust dylib is only embedded when frameworks are
# dynamic: building the whole graph static would ship an app without it, dead
# at first dlopen. Each pod builds as its own framework here, so the static
# ONNX archives link into flutter_onnxruntime.framework and work; the check
# is simply stricter than the layout it is checking. The same bypass, for the
# same plugin pairing, as in `../macos/Podfile`.
pre_install do |installer|
  Pod::Installer::Xcode::TargetValidator.send(
    :define_method,
    :verify_no_static_framework_transitive_dependencies,
  ) {}
end

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end

  # Patrol's XCUITest bundle. `:complete` rather than `:search_paths` — unlike
  # the unit tests above, this target *links* the patrol pod: `RunnerUITests.m`
  # is `@import patrol;` and a macro expansion, so headers alone are not enough.
  #
  # Patrol's own setup guide leads with Swift Package Manager, which this
  # project has disabled (`flutter config --no-enable-swift-package-manager`)
  # because `flutter_vodozemac`'s xcframework loses its `Versions/Current`
  # symlink through the SPM path and code signing breaks. The CocoaPods path is
  # still supported and is the one taken here.
  #
  # No `use_modular_headers!`: the patrol guide adds it, but `use_frameworks!`
  # above already builds every pod as a module, and turning it on would change
  # how the whole existing pod graph is built for a target that has been
  # verified to link as it stands.
  target 'RunnerUITests' do
    inherit! :complete
  end
end

# The Share Extension is integrated with no pods, deliberately.
#
# It must not inherit Runner's: `flutter_install_all_ios_pods` pulls in the
# Flutter engine and every plugin, and an app extension that links the engine is
# an extension that will be killed for exceeding its memory limit before it has
# copied a photo. `ShareViewController` imports UIKit and Foundation and nothing
# else, which is the whole design — see the class doc for why it cannot hold a
# Matrix session.
#
# The block is here rather than absent so that CocoaPods generates
# `Pods-ShareExtension.{debug,release}.xcconfig`, which
# `ShareExtension/ShareExtension-{Debug,Release}.xcconfig` includes optionally.
# That is what stops `pod install` warning about a base configuration it did not
# set, and it means the day this target does need a pod, adding it here is the
# only step.
#
# `NotificationService` is *not* listed: it needs nothing either, and it has no
# custom xcconfig for CocoaPods to collide with. Its README records the same
# decision.
target 'ShareExtension' do
  use_frameworks!
end

# The WidgetKit extension, integrated with no pods, for the same reason and one
# sharper.
#
# It must not inherit Runner's: `flutter_install_all_ios_pods` pulls in the
# Flutter engine and every plugin, and a widget extension that links the engine
# is one the system kills for exceeding its memory limit before it has drawn a
# row. The limit here is tighter than the Share Extension's — a widget is woken
# by the OS on its own schedule, repeatedly, and an extension that gets killed
# often enough stops being scheduled at all, which the user sees as a blank
# rectangle they eventually delete. Everything in `WeftWidget/` imports SwiftUI,
# WidgetKit and Foundation and nothing else.
#
# The block is here rather than absent so that CocoaPods generates
# `Pods-WeftWidget.{debug,release}.xcconfig`, which
# `WeftWidget/WeftWidget-{Debug,Release}.xcconfig` includes optionally. That is
# what stops `pod install` warning about a base configuration it did not set,
# and it means the day this target does need a pod, adding it here is the only
# step.
#
# The macOS half of this target is *not* listed in `../macos/Podfile`: it needs
# nothing either and its single `WeftWidget-macOS.xcconfig` has no CocoaPods
# include to collide with, which is the NotificationService arrangement rather
# than this one.
target 'WeftWidget' do
  use_frameworks!
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end

  # onnxruntime-c is a static archive dressed as a framework, and under dynamic
  # use_frameworks! CocoaPods never hands it to the plugin's own link — the
  # very situation the disabled validator above was refusing. Without this the
  # app fails at link with every ORT symbol missing (`_OrtGetApiBase`,
  # `_OrtSessionOptionsAppendExecutionProvider_CoreML`, …).
  #
  # Appended into the plugin's own xcconfig values, because a target-level
  # build setting would shadow them instead. Unlike the macOS xcframework this
  # one carries a device slice and a simulator slice, so the search path is
  # written per SDK — a single path would link the wrong architecture into
  # whichever of the two was not chosen. Each conditional repeats the base
  # value rather than saying `$(inherited)`, which at this level would inherit
  # from the *project*, not from the line above it.
  root = '"${PODS_ROOT}/onnxruntime-c/onnxruntime.xcframework'
  device = "#{root}/ios-arm64\""
  simulator = "#{root}/ios-arm64_x86_64-simulator\""
  Dir.glob(File.join(installer.sandbox.root,
                     'Target Support Files/flutter_onnxruntime/*.xcconfig')) do |f|
    text = File.read(f)
    text = text.sub(/^FRAMEWORK_SEARCH_PATHS = (.*)$/) do
      base = Regexp.last_match(1)
      [
        "FRAMEWORK_SEARCH_PATHS = #{base}",
        "FRAMEWORK_SEARCH_PATHS[sdk=iphoneos*] = #{base} #{device}",
        "FRAMEWORK_SEARCH_PATHS[sdk=iphonesimulator*] = #{base} #{simulator}",
      ].join("\n")
    end
    text = text.sub(/^OTHER_LDFLAGS = (.*)$/) do
      "OTHER_LDFLAGS = #{Regexp.last_match(1)} -framework \"onnxruntime\""
    end
    File.write(f, text)
  end
end
