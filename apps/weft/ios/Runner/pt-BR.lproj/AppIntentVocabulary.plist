<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Siri example phrases, one set per intent in INIntentsSupported. App
     Store Connect rejects the Siri support (ITMS-90626) for every language
     the bundle has a .lproj for that lacks them. siri_vocabulary_test.dart
     holds every localization to all three. -->
<dict>
	<key>IntentPhrases</key>
	<array>
		<dict>
			<key>IntentName</key>
			<string>INSendMessageIntent</string>
			<key>IntentExamples</key>
			<array>
				<string>Envie uma mensagem pelo Sennit</string>
				<string>Responda à Ana no Sennit</string>
				<string>Mande uma mensagem para o Ben pelo Sennit</string>
			</array>
		</dict>
		<dict>
			<key>IntentName</key>
			<string>INSearchForMessagesIntent</string>
			<key>IntentExamples</key>
			<array>
				<string>Leia minhas mensagens do Sennit</string>
				<string>Mostre minhas novas mensagens no Sennit</string>
				<string>Tenho mensagens novas no Sennit?</string>
			</array>
		</dict>
		<dict>
			<key>IntentName</key>
			<string>INSetMessageAttributeIntent</string>
			<key>IntentExamples</key>
			<array>
				<string>Marque minhas mensagens do Sennit como lidas</string>
				<string>Marque minhas mensagens como lidas no Sennit</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
