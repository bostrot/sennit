<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The host app's half of the Share Extension's App Group. Both bundle ids
	     must be entitled to the same group or the two processes get two
	     containers and the drain reads an empty directory forever.

	     This file did not exist before Phase 04. Xcode writes every capability
	     you enable in Signing & Capabilities into it, so if Push Notifications
	     is turned on for this target an `aps-environment` key will appear here
	     too — that is expected and should be committed. Nothing is being removed
	     by this file's existence: there was no entitlements file to remove
	     anything from.

	     See docs/decisions/adr-002-ios-signing-handoff.md for what has to happen
	     on the developer portal before a signed build will accept this. -->
	<!-- SiriKit messaging and CarPlay. CarPlay shows a messaging app, reads
	     its notifications and offers its Siri intents only when the app is
	     signed with both; Apple assigned the CarPlay Communication entitlement
	     to the team on 2026-11-19, and both capabilities are enabled on the
	     com.bostrot.weft App ID, so automatic signing puts them in the
	     profile. See docs/car-integrations.md. -->
	<!-- Push Notifications, for Sennit's push gateway (APNs, token-based).
	     Development or production per configuration, from APS_ENVIRONMENT in
	     Flutter/Debug.xcconfig and Release.xcconfig, so it always matches the
	     profile the build is signed with. The App ID has the capability
	     enabled; see docs/ops/push-gateway.md. -->
	<key>aps-environment</key>
	<string>$(APS_ENVIRONMENT)</string>
	<key>com.apple.developer.siri</key>
	<true/>
	<key>com.apple.developer.carplay-communication</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.bostrot.weft</string>
	</array>
</dict>
</plist>
