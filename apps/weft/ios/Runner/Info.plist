<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.bostrot.weft</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>weft</string>
			</array>
		</dict>
	</array>

	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<true/>
	<key>CFBundleDisplayName</key>
	<string>Sennit</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<!-- Both are required to exist before iOS will let the picker open at all;
	     the strings are what the permission prompt shows the user. -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Sennit needs your photo library so you can send photos and videos in a conversation.</string>
	<key>NSCameraUsageDescription</key>
	<string>Sennit needs the camera so you can take a photo and send it in a conversation.</string>
	<!-- Calling. Without this key the app is *terminated* the first time WebRTC
	     opens a capture device — not refused, not prompted: killed — so its
	     absence is a crash on the first call rather than a call with no sound.
	     The camera description above already covers a video call. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Sennit shares your position only when you tap "share location" in a chat.</string>
	<!-- Neither of the next two is a permission Sennit asks for. App Store
	     Connect scans the binary for the APIs behind them — geolocator links
	     the "always" location call, add_2_calendar links EventKit — and
	     refuses a build whose Info.plist has no sentence for an API it can
	     see, used or not: the first TestFlight upload failed processing on
	     the calendar one. The sentences say what the app does do. -->
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Sennit shares your position only when you tap "share location" in a chat. It never follows it in the background.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>Sennit adds an event to your calendar only when you ask it to, for a date mentioned in a chat.</string>
	<key>NSContactsUsageDescription</key>
	<string>Sennit shows your address book names for people instead of the names messaging networks assign them. Contacts are matched on this device and never uploaded.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Sennit needs the microphone so you can talk in a voice or video call.</string>
	<key>CFBundleName</key>
	<string>sennit</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- An `event_id_only` push carries no text, so the app has to be given the
	     chance to fetch and decrypt the event before anything can be shown.
	     Without `remote-notification` iOS delivers the payload only when the app
	     is already in the foreground, and every push while it is backgrounded
	     shows the placeholder alert from `kIosDefaultPayload` and nothing else.
	     `fetch` is what lets the client catch up on sync in the background so a
	     notification is not the first the app has heard of a conversation.

	     `voip` is what lets `PKPushRegistry` be created at all and what keeps the
	     WebRTC connection alive once the call screen is no longer in front: a
	     call the user backgrounds to look up an address must not go silent. It
	     is *not* what makes an incoming call ring — CallKit does that, off a VoIP
	     push signed with its own certificate (see the iOS signing handoff ADR). -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
		<string>fetch</string>
		<string>voip</string>
		<string>audio</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
