<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Siri example phrases, one set per intent in INIntentsSupported. App
     Store Connect rejects the Siri support (ITMS-90626) for every language
     the bundle has a .lproj for that lacks them. siri_vocabulary_test.dart
     holds every localization to all three. -->
<dict>
	<key>IntentPhrases</key>
	<array>
		<dict>
			<key>IntentName</key>
			<string>INSendMessageIntent</string>
			<key>IntentExamples</key>
			<array>
				<string>Envoie un message avec Sennit</string>
				<string>Réponds à Anna dans Sennit</string>
				<string>Écris à Ben sur Sennit</string>
			</array>
		</dict>
		<dict>
			<key>IntentName</key>
			<string>INSearchForMessagesIntent</string>
			<key>IntentExamples</key>
			<array>
				<string>Lis mes messages Sennit</string>
				<string>Montre mes nouveaux messages dans Sennit</string>
				<string>Est-ce que j’ai de nouveaux messages sur Sennit</string>
			</array>
		</dict>
		<dict>
			<key>IntentName</key>
			<string>INSetMessageAttributeIntent</string>
			<key>IntentExamples</key>
			<array>
				<string>Marque mes messages Sennit comme lus</string>
				<string>Marque mes messages comme lus dans Sennit</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
