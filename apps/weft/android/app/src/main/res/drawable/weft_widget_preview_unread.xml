<?xml version="1.0" encoding="utf-8"?>
<!-- Widget-picker preview for the compact unread tile.

     A vector rather than a PNG, so there is one file instead of five densities
     and nothing to regenerate when the tokens move. `previewImage` accepts any
     drawable; the launcher rasterises it at whatever size its picker uses.

     It is a *shape* study rather than a screenshot on purpose: a preview is a
     static asset compiled into the APK, so it cannot show real conversations,
     and drawing plausible-looking fake ones would be the picker teaching the
     user to expect names before they have agreed to any leaving the encrypted
     store. Colours are the `weft_design` seed's light scheme, which is also what
     the widget itself falls back to below Android 12.

     Canvas is 96×96 for a 1×1 tile. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="96dp"
    android:height="96dp"
    android:viewportWidth="96"
    android:viewportHeight="96">
    <!-- The card. #FCF8FF is ColorScheme.fromSeed(0xFF6C5CE7).surface, light. -->
    <path
        android:fillColor="#FCF8FF"
        android:pathData="M14,0 L82,0 A14,14 0 0 1 96,14 L96,82 A14,14 0 0 1 82,96 L14,96 A14,14 0 0 1 0,82 L0,14 A14,14 0 0 1 14,0 Z" />
    <!-- The count, as a filled pill: the number itself is the widget's content
         and cannot be drawn here without inventing one. -->
    <path
        android:fillColor="#5D5791"
        android:pathData="M30,34 L66,34 A13,13 0 0 1 66,60 L30,60 A13,13 0 0 1 30,34 Z" />
    <!-- The "unread" caption beneath it. -->
    <path
        android:fillColor="#47464F"
        android:pathData="M32,68 L64,68 A3,3 0 0 1 64,74 L32,74 A3,3 0 0 1 32,68 Z" />
</vector>
