# Dart / Flutter
.dart_tool/
.packages
build/
*.iml
.idea/
.vscode/

# Generated by `flutter pub get`; regenerated on every machine and full of
# absolute local paths.
**/.flutter-plugins
**/.flutter-plugins-dependencies

# Pub workspaces resolve at the root; member lockfiles are stray files.
apps/*/pubspec.lock
packages/*/pubspec.lock

# Local test homeserver state. Contains a generated signing key and a config
# with registration wide open — never commit it.
tooling/docker/synapse-data/
tooling/docker/synapse-remote-data/

# Golden test failure output
**/failures/

# Screen recordings made for store review; large, and kept out of the repo.
tooling/store/review-videos/

# Regenerated by `patrol_cli` on every run: the bundle that imports each test in
# integration_test/patrol/, and the entrypoint proxy it needs because the suite
# does not live in patrol_cli's default directory.
apps/weft/integration_test/patrol/test_bundle.dart
apps/weft/integration_test/patrol_test_bundle.dart

# macOS
.DS_Store
apps/weft/macos/Pods/
apps/weft/macos/Flutter/ephemeral/
apps/weft/ios/Pods/
apps/weft/ios/Flutter/ephemeral/
.slim/deepwork/
__pycache__/
*.pyc

# Firebase resources, generated in CI from the GOOGLE_SERVICES_JSON secret
# by tooling/scripts/firebase_android_config.py.
apps/weft/android/app/src/main/res/values/firebase.xml
